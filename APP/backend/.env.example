# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite file. Use an absolute path in production.
DB_PATH=data/yahdav.sqlite3

# ── File uploads ─────────────────────────────────────────────────────────────
# Directory where uploaded photos are stored.
UPLOADS_DIR=data/uploads

# ── Frontend bundles served same-origin ─────────────────────────────────────
# The built web app and admin dashboard, served from /  and /admin
# respectively (see backend/src/utils/mountSpa.ts). Populated by the
# release package (see docs/LOCAL_SETUP.md) — leave unset for ordinary
# backend-only development, where web/admin run their own dev servers.
WEB_PUBLIC_DIR=public/web
ADMIN_PUBLIC_DIR=public/admin

# ── Domain (remote deployment only — see docs/REMOTE_SETUP.md) ──────────────
# Not read by the application anywhere — this app doesn't need to know its
# own public URL for anything currently. Purely a placeholder to fill in
# once a real domain exists, as a reminder of what else needs it: nginx
# server_name, the SSL certificate, and ADMIN_CORS_ORIGIN below if web/admin
# ever end up hosted on a different origin than this server again.
# DOMAIN=your-domain.example.com

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (web app + admin
# dashboard). Set to the deployed web/admin URLs in production.
ADMIN_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Push notifications ────────────────────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
