{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "CommonJS",
    "moduleResolution":"node",
    "outDir":          "dist",
    "rootDir":         "src",
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "resolveJsonModule": true,
    "sourceMap":       true,
    "baseUrl":         ".",
    "paths":
    {
      "@yahdav/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
