{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    // Off (was true): vite.config.ts now imports @shared/config.ts (for
    // APP_NAME) directly, pulling it into this file's own compilation
    // graph — shared/package.json has no "type": "module", so nodenext
    // treats shared's .ts files as CommonJS, which verbatimModuleSyntax
    // then rejects on shared's normal `export const`. This only affects
    // how vite.config.ts itself is type-checked, not app bundling.
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
